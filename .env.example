# Supabase. Публикуемые наружу значения — анонимный ключ рассчитан на то,
# что данные защищены RLS, а не секретностью ключа.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# service_role обходит RLS. В кабинете НЕ использовать: инвариант 4 держится
# на политиках, а service_role их игнорирует. Нужен только серверным
# заданиям — выгрузке в каналы и вызову app.expire_mandates().
# SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Вход по ссылке на почту требует ОДНОЙ настройки в панели Supabase:
#   Authentication → URL Configuration → Redirect URLs:
#     http://localhost:3000/auth/callback   (и адрес продакшена)
#
# Шаблон письма менять не надо: родное письмо ведёт на /auth/v1/verify самой
# Supabase, а та присылает браузер на /auth/callback с ?code= (поток PKCE).
# Ссылку нужно открывать в том же браузере, откуда её запросили.
#
# Маршрут /auth/confirm ждёт token_hash и работает только со своим шаблоном
# письма, а шаблоны на бесплатном тарифе недоступны — см. README.

# --- Напоминания о задачах -------------------------------------------------
# Рассылку запускает /api/cron/reminders по расписанию (см. vercel.json).
#
# Маршрут держит ключ service_role и обходит RLS, поэтому закрыт секретом.
# Если CRON_SECRET не задан, маршрут ОТКАЗЫВАЕТ, а не открывается: пустой
# секрет это ошибка настройки, а не выключенная проверка.
CRON_SECRET=<длинная случайная строка>

# Ключ service_role. Только для фоновых заданий: в кабинете он запрещён,
# потому что обходит политики, на которых держится инвариант 4.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Токен бота. Без него напоминания остаются в очереди со записанной
# причиной, а не теряются молча.
TELEGRAM_BOT_TOKEN=<token>

# --- Собственный адрес сайта -----------------------------------------------
# Нужен карте сайта, robots.txt и превью при пересылке: там требуются
# АБСОЛЮТНЫЕ ссылки, а относительные мессенджер не откроет.
#
# На Vercel можно не задавать: подставится VERCEL_PROJECT_PRODUCTION_URL,
# боевой домен проекта. Задавайте, когда домен свой: иначе в выдачу уедет
# адрес вида *.vercel.app, и сменить его потом будет дороже.
#
# Без косой черты на конце.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Черновик описания объекта ---------------------------------------------
# Кнопка «Черновик по данным карточки» в кабинете. Без ключа кнопка честно
# отвечает, что генерация не настроена, — остальной кабинет работает как
# работал.
#
# На Vercel ключ подставляет платформа (AI Gateway подключается в проекте),
# локально — задайте свой.
AI_GATEWAY_API_KEY=<ключ AI Gateway>

# Модель. По умолчанию anthropic/claude-haiku-5.5: четыре предложения по
# десятку полей — не та задача, за которую стоит платить как за рассуждения.
# AI_DESCRIPTION_MODEL=anthropic/claude-haiku-5.5
