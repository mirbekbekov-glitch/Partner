# Переменные для локальной разработки.
#
# На боевом их заменяют привязки и секреты Worker (cloudflare.config.ts).
# База, хранилище снимков, модель и отправка писем приходят привязками —
# ключей для них не существует вовсе, и это главная причина переезда с
# Supabase: нечего хранить, нечего потерять.

# --- Собственный адрес сайта -----------------------------------------------
# Нужен карте сайта, robots.txt, превью при пересылке и ссылке в письме для
# входа: там требуются АБСОЛЮТНЫЕ ссылки.
#
# Без косой черты на конце.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Напоминания о задачах -------------------------------------------------
# Рассылку будит расписание Worker (см. cloudflare.config.ts).
#
# Маршрут ходит в базу без сессии агента, то есть мимо проверок прав,
# поэтому закрыт секретом. Если CRON_SECRET не задан, маршрут ОТКАЗЫВАЕТ,
# а не открывается: пустой секрет это ошибка настройки, а не выключенная
# проверка.
CRON_SECRET=<длинная случайная строка>

# Токен бота. Без него напоминания остаются в очереди с записанной
# причиной, а не теряются молча.
TELEGRAM_BOT_TOKEN=<token>

# --- Черновик описания объекта ---------------------------------------------
# Кнопка «Черновик по данным карточки» в кабинете. На боевом модель
# вызывается привязкой Workers AI — без ключа и без карты.
#
# Локально ключ нужен только если хотите проверить генерацию.
# AI_GATEWAY_API_KEY=<ключ AI Gateway>

# Модель. По умолчанию та, что в lib/ai/describe.ts: четыре предложения по
# десятку полей — не та задача, за которую стоит платить как за рассуждения.
# AI_DESCRIPTION_MODEL=
