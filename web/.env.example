# Строка подключения к базе. Сервер подключается полноправным пользователем и
# понижает права на каждую транзакцию: anon для каталога, auth_service для
# входа, authenticated для кабинета.
DATABASE_URL=postgresql://postgres@localhost/partner?host=/tmp&port=55432

# Роли, до которых понижаются права. Менять незачем, кроме отладки.
CATALOG_DB_ROLE=anon
AUTH_DB_ROLE=auth_service
CABINET_DB_ROLE=authenticated

# Ключ подписи сессии кабинета. Без него вход подделывается тривиально.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Как отправлять код входа: dev печатает его в журнал сервера и показывает на
# странице; smtp шлёт письмо; whatsapp требует Business API (не подключён).
# Канал входа — почта (инвариант 6, третья редакция).
# ДОСТАВКА КОДОВ ВХОДА
#
#   dev   — код печатается в журнал И ПОКАЗЫВАЕТСЯ НА СТРАНИЦЕ ВХОДА. Это
#           весь его смысл: достать код больше неоткуда. В публичном вебе
#           это открытая дверь — любой введёт чужой адрес и прочитает код;
#   email — настоящая отправка через HTTP API провайдера (ниже);
#   whatsapp — провайдер не подключён, см. docs/market/platform-spec.md.
OTP_TRANSPORT=dev

# Почта. Провайдер обязан иметь HTTP API: исходящего SMTP в Cloudflare Workers
# нет, и никакая библиотека этого не изменит. Подключён Resend.
# MAIL_PROVIDER=resend
# MAIL_FROM=Liberterra <noreply@example.kg>
# MAIL_API_KEY=            # в бою — секрет воркера, не переменная в репозитории

# Записи SPF и DKIM в DNS домена нужны так же, как ключ: без них письмо с
# кодом уходит в спам, и человек решит, что система сломана. Подробности в
# web/lib/mail.ts.
#
# Настроек SMTP здесь нет и не будет: исходящего SMTP в Cloudflare Workers не
# существует. Раньше они тут стояли, и это было приглашением настроить то,
# что в бою не работает вовсе.

# WhatsApp. ВКЛЮЧИТЬ ЭТОТ КАНАЛ СЕГОДНЯ НЕЛЬЗЯ: OTP_TRANSPORT=whatsapp
# отказывается с объяснением. Отправка готова (web/lib/whatsapp.ts), а вход по
# телефону — нет: по инварианту 6 ключ личности это адрес почты. Иначе человек
# получил бы ПЛАТНОЕ сообщение с кодом и уткнулся в ошибку про почту.
# Что решить — docs/market/platform-spec.md, раздел 7, пункт 1.
#
# Настройки ниже нужны будут в тот день и проверены дымовой проверкой уже
# сейчас. Чего они НЕ заменяют: проверки бизнеса в Meta, платёжного способа и
# утверждённого шаблона категории «аутентификация» — свободным текстом код
# входа не доставляется. Каждое сообщение платное.
#
# WHATSAPP_PROVIDER=cloud   # агрегатор, отдающий Cloud API, тоже cloud
# WHATSAPP_API_BASE=https://graph.facebook.com/v23.0   # или адрес агрегатора
# WHATSAPP_TOKEN=           # в бою — секрет воркера
# WHATSAPP_PHONE_ID=        # идентификатор номера отправителя в кабинете Meta
# WHATSAPP_TEMPLATE=        # имя утверждённого шаблона
# WHATSAPP_LOCALE=ru        # язык шаблона, как он заведён в Meta

SITE_URL=http://localhost:3000
# ХРАНИЛИЩЕ ФОТОГРАФИЙ
#
# Байты отдаёт приложение, а не хранилище напрямую: право на файл проверяется
# в базе на каждый запрос (инвариант 11). Поэтому бакет закрытый, публичных
# ссылок у файлов нет, и исходящий трафик фотографий оплачивает хост
# приложения. Это осознанная цена за то, что снятый с публикации объект
# перестаёт отдаваться в ту же секунду.
#
#   disk — каталог на диске. Разработка и тесты. В продакшне не годится:
#          диск контейнера исчезает при следующем выкладывании, а в воркере
#          запись и вовсе отвечает «operation not permitted»;
#   r2   — привязка R2 (env.R2). Продакшн на Cloudflare: ключей доступа к
#          бакету не нужно, воркер обращается к нему внутри платформы;
#   s3   — любое S3-совместимое: Supabase Storage, MinIO, S3 — и R2 тоже,
#          если приложение живёт не в воркере.
# Под workerd эта же строка должна быть по TCP: unix-сокет там недоступен.
# Список переменных, нужных воркеру, лежит в cloudflare.config.ts, значения
# для стенда — в .dev.vars (в репозитории не хранится).

PHOTO_STORAGE=disk
PHOTO_DIR=./dev-photos

# Для PHOTO_STORAGE=s3. Supabase Storage (так сейчас в бою):
#   endpoint https://<ref>.supabase.co/storage/v1/s3
#   region   регион проекта, например ap-northeast-1
#   ключи    панель Supabase → Storage → S3 Access Keys
# Cloudflare R2:
#   endpoint https://<account-id>.r2.cloudflarestorage.com
#   region   auto
# PHOTO_S3_BUCKET=liberterra-photos
# PHOTO_S3_ENDPOINT=
# PHOTO_S3_REGION=auto
# PHOTO_S3_ACCESS_KEY_ID=
# PHOTO_S3_SECRET_ACCESS_KEY=
#
# Перенос уже накопленных файлов с диска в бакет — один раз:
#   npm run photos:to-storage

# Канал уведомлений о показах: dev (печать в журнал), telegram, whatsapp.
# Телеграму нужен TELEGRAM_BOT_TOKEN; у агента в базе уже есть telegram_id.
NOTIFY_TRANSPORT=dev
# TELEGRAM_BOT_TOKEN=

# Роль, под которой очередь уведомлений разбирает отдельный процесс
# (npm run notify). Ей открыты три функции и ни одной таблицы.
NOTIFY_DB_ROLE=notifier

# Название агентства в объявлениях на площадках. Попадает в фид как
# организация-продавец. Телефон для объявлений задаётся у канала в кабинете,
# а не здесь: у разных площадок он может быть разным.
AGENCY_NAME=Платформа профессионалов
