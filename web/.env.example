# Строка подключения к базе каталога.
# Локально: база собирается db/rebuild.sh, затем tests/seed.sql и db/dev_seed.sql.
DATABASE_URL=postgresql://postgres@localhost:55432/partner?host=/tmp

# Роль, под которой каталог читает базу. Должна совпадать с ролью, которой
# выданы права в 0006_rls.sql: каталогу нужен ровно anon, и ничего больше.
CATALOG_DB_ROLE=anon

# Публичный адрес каталога. Нужен карте сайта и каноническим ссылкам.
SITE_URL=http://localhost:3000
