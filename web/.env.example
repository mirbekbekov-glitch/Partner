# Строка подключения к базе. Сервер подключается полноправным пользователем и
# понижает права на каждую транзакцию: anon для каталога, auth_service для
# входа, authenticated для кабинета.
DATABASE_URL=postgresql://postgres@localhost/partner?host=/tmp&port=55432

# Роли, до которых понижаются права. Менять незачем, кроме отладки.
CATALOG_DB_ROLE=anon
AUTH_DB_ROLE=auth_service
CABINET_DB_ROLE=authenticated

# Ключ подписи сессии кабинета. Без него вход подделывается тривиально.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Как отправлять код входа: dev печатает его в журнал сервера и показывает на
# странице; smtp шлёт письмо; whatsapp требует Business API (не подключён).
# Канал входа — почта (инвариант 6, третья редакция).
OTP_TRANSPORT=dev

# Почта. Нужны и адрес отправителя, и записи SPF/DKIM в DNS домена — иначе
# письмо с кодом уходит в спам, и человек решит, что система сломана.
# Подробности в web/lib/mail.ts.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Платформа профессионалов <noreply@partner.kg>

SITE_URL=http://localhost:3000
# Каталог хранилища фотографий. Байты отдаёт приложение, а не хранилище
# напрямую: право на файл проверяется в базе на каждый запрос (инвариант 11).
PHOTO_DIR=./dev-photos

# Канал уведомлений о показах: dev (печать в журнал), telegram, whatsapp.
# Телеграму нужен TELEGRAM_BOT_TOKEN; у агента в базе уже есть telegram_id.
NOTIFY_TRANSPORT=dev
# TELEGRAM_BOT_TOKEN=

# Роль, под которой очередь уведомлений разбирает отдельный процесс
# (npm run notify). Ей открыты три функции и ни одной таблицы.
NOTIFY_DB_ROLE=notifier

# Название агентства в объявлениях на площадках. Попадает в фид как
# организация-продавец. Телефон для объявлений задаётся у канала в кабинете,
# а не здесь: у разных площадок он может быть разным.
AGENCY_NAME=Платформа профессионалов
