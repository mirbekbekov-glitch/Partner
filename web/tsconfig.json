{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // Явное расширение .ts в импортах внутри lib/. Без него дымовые проверки
    // не могут импортировать эти модули напрямую: они запускаются обычным
    // node со снятием типов, а он расширение не достраивает. Сборщик такой
    // импорт понимает, а проверять руками то, что проверяется запуском, —
    // плохой размен.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    // Типы привязок воркера. Генерируются `cf workers types` при разработке и
    // сборке; для отдельной проверки типов команду надо позвать самому.
    ".cloudflare/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
